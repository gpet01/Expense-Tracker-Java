import java.util.ArrayList;

public class ToDoList {

	private ArrayList<Task> tasks = new ArrayList<Task>();
	
	//Methodos pou pros8etei kainourio task sto array tasks pou perilamvanei thn klash Task
	public void addTask(String title) {
		tasks.add(new Task(title));
	}
	
	public void listTasks() {
		if(tasks.isEmpty()) {
			System.out.println("Η λίστα είναι άδεια");
			return;
		}
		for(int i=0; i<tasks.size(); i++) {
			System.out.println( (i+1) + 1 + " . " + tasks.get(i));
		}
	}
	
	public void removeTask(int index) {
		if (index >= 0 && index < tasks.size() ) {
			tasks.remove(index);
			System.out.println("Task διαγράφηκε");
		} else {
			System.out.println("Μη έγκυρος αριθμός!");
		}
	}
	
	public void completedTask(int index) {
		if ( index >= 0 && index < tasks.size() ) {
			tasks.get(index).setCompleted(true);
			System.out.println("Το task έχει ολοκληρωθεί!");
		} else {
			System.out.println("To task ΔΕΝ έχει ολοκληρωθεί! Μη έγκυρος αριθμός");
		}
	}
	
}
